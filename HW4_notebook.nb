Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "Parameters", "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"paramSub", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"r1", "->", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"1", "-", "0.10"}], "]"}]}], ",", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"ITM", ":", "T"}], "=", 
         RowBox[{
          RowBox[{"10", "%", " ", "so", " ", "r"}], "=", 
          RowBox[{"sqrt", 
           RowBox[{"(", "0.9", ")"}]}]}]}], "*)"}], 
       RowBox[{"r2", "->", "1"}], ",", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
          RowBox[{"ETM", ":", "T"}], "=", "0"}], ",", 
         RowBox[{"perfect", " ", "mirror"}]}], "*)"}], 
       RowBox[{"t1", "->", 
        RowBox[{"Sqrt", "[", "0.10", "]"}]}], ",", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"ITM", ":", "t"}], "=", 
         RowBox[{"sqrt", 
          RowBox[{"(", "T", ")"}]}]}], "*)"}], 
       RowBox[{"lx", "->", "5"}], ",", 
       RowBox[{"ly", "->", "5"}], ",", 
       RowBox[{"(*", 
        RowBox[{"short", " ", "Michelson", " ", 
         RowBox[{"arms", "[", "m", "]"}]}], "*)"}], 
       RowBox[{"Lx", "->", "4000"}], ",", 
       RowBox[{"Ly", "->", "4000"}], ",", 
       RowBox[{"(*", 
        RowBox[{"FP", " ", "arm", " ", 
         RowBox[{"lengths", "[", "m", "]"}]}], "*)"}], 
       RowBox[{"\[Lambda]", "->", 
        RowBox[{"1064", "*", 
         RowBox[{"10", "^", 
          RowBox[{"-", "9"}]}]}]}]}], "  ", 
      RowBox[{"(*", 
       RowBox[{"wavelength", "[", "m", "]"}], "*)"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"k", "=", 
     RowBox[{"2", "*", 
      RowBox[{"Pi", "/", 
       RowBox[{"(", 
        RowBox[{"\[Lambda]", "/.", " ", "paramSub"}], ")"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Common", " ", "and", " ", "differential", " ", "phases"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"\[CapitalPhi]c", "=", 
      RowBox[{"k", "*", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"Lx", "+", "Ly"}], ")"}], "/", "2"}]}]}], ",", 
     RowBox[{"\[CapitalPhi]d", " ", "sweeps"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"PhicVal", "=", 
     RowBox[{"k", "*", 
      RowBox[{"(", "4000", ")"}]}]}], ";"}], "   ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"symmetric", " ", "arms", " ", "so", " ", "\[CapitalPhi]c"}], "=", 
     RowBox[{"k", "*", "L"}]}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Transfer", " ", "function"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"TFexpr", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"I", "*", 
          RowBox[{"(", 
           RowBox[{"\[CapitalPhi]c", "+", "\[CapitalPhi]d"}], ")"}]}], "]"}], 
        "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          RowBox[{"Exp", "[", 
           RowBox[{"2", "*", "I", "*", "\[CapitalPhi]d"}], "]"}]}], ")"}], "*",
         "r2", "*", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{"2", "*", "I", "*", "\[CapitalPhi]c"}], "]"}], "*", "r1", 
           "*", "r2"}]}], ")"}], "*", 
        RowBox[{"t1", "^", "2"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"2", "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{"2", "*", "I", "*", "\[CapitalPhi]d"}], "]"}], "-", 
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{"2", "*", "I", "*", "\[CapitalPhi]c"}], "]"}], "*", "r1", 
           "*", "r2"}]}], ")"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{"2", "*", "I", "*", 
             RowBox[{"(", 
              RowBox[{"\[CapitalPhi]c", "+", "\[CapitalPhi]d"}], ")"}]}], 
            "]"}], "*", "r1", "*", "r2"}]}], ")"}]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"TFsub", "=", 
     RowBox[{"TFexpr", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"r1", "->", 
         RowBox[{"Sqrt", "[", "0.9", "]"}]}], ",", 
        RowBox[{"r2", "->", "1"}], ",", 
        RowBox[{"t1", "->", 
         RowBox[{"Sqrt", "[", "0.1", "]"}]}], ",", 
        RowBox[{"\[CapitalPhi]c", "->", "PhicVal"}]}], "}"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Simple", " ", "Michelson", " ", "TF", " ", "for", " ", "comparison", " ", 
     RowBox[{"(", 
      RowBox[{"no", " ", "arm", " ", "cavities"}], ")"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"E_as", "/", "E_in"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "/", "2"}], ")"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"e", "^", 
           RowBox[{"{", 
            RowBox[{"2", "i\[CurlyPhi]x"}], "}"}]}], "-", 
          RowBox[{"e", "^", 
           RowBox[{"{", 
            RowBox[{"2", "i\[CurlyPhi]y"}], "}"}]}]}], ")"}]}], "->", 
       RowBox[{"i", "*", "sin", 
        RowBox[{"(", "\[CapitalPhi]d", ")"}], " ", "at", " ", 
        "\[CapitalPhi]c"}]}], "=", "0"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"TFmich", "=", 
     RowBox[{"I", "*", 
      RowBox[{"Sin", "[", "\[CapitalPhi]d", "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Plot", " ", "over", " ", "a", " ", "few", " ", "linewidths", " ", 
      "around", " ", "\[CapitalPhi]d"}], "=", "0"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Cavity", " ", 
      RowBox[{"linewidth", ":", 
       RowBox[{
        RowBox[{"\[Delta]\[CapitalPhi]", "~", "T"}], "/", 
        RowBox[{"(", "2", ")"}]}]}]}], "=", 
     RowBox[{"0.05", " ", "rad"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"PhidRange", "=", "0.2"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Re", "[", "TFsub", "]"}], ",", 
       RowBox[{"Im", "[", "TFsub", "]"}], ",", 
       RowBox[{"Re", "[", "TFmich", "]"}], ",", 
       RowBox[{"Im", "[", "TFmich", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[CapitalPhi]d", ",", 
       RowBox[{"-", "PhidRange"}], ",", "PhidRange"}], "}"}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Re[FPMI]\>\"", ",", "\"\<Im[FPMI]\>\"", 
        ",", "\"\<Re[Michelson]\>\"", ",", "\"\<Im[Michelson]\>\""}], "}"}]}],
      ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Blue", ",", "Red", ",", "Dashed", ",", 
        RowBox[{"{", 
         RowBox[{"Red", ",", "Dashed"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<\\!\\(\\*SubscriptBox[\\(\[CapitalPhi]\\), \
\\(d\\)]\\)\>\"", 
        ",", "\"\<\\!\\(\\*FractionBox[\\(E_as\\), \\(E_in\\)]\\)\>\""}], 
       "}"}]}], ",", 
     RowBox[{
     "PlotLabel", 
      "->", "\"\<FPMI vs Michelson AS port transfer function\>\""}], ",", 
     RowBox[{"GridLines", "->", "Automatic"}], ",", 
     RowBox[{"PlotRange", "->", "All"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{3.984680868826482*^9},
 CellLabel->
  "In[182]:=",ExpressionUUID->"479b35cf-a7c4-4b90-9d5a-1f2447d1cc8c"],

